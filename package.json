{
  "name": "airtool",
  "version": "0.1.0",
  "description": "Typed Airtable utilities with schema-aware helpers.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "format": "biome format --write .",
    "write": "biome check --write .",
    "check": "biome check --write .",
    "lint": "biome check . && oxlint --type-aware --tsconfig tsconfig.json --config .oxlintrc.json .",
    "lint:fix": "biome check --write . && oxlint --type-aware --tsconfig tsconfig.json --config .oxlintrc.json --fix .",
    "dev": "bun src/index.ts"
  },
  "dependencies": {
    "airtable": "^0.12.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/node": "^25.0.10",
    "oxlint": "^1.41.0",
    "oxlint-tsgolint": "^0.11.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
